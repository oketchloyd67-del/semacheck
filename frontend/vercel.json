{
  "version": 2,
  "builds": [
    { "src": "sw.js", "use": "@vercel/static", "config": { "headers": { "Cache-Control": "no-cache" } } },
    { "src": "site.webmanifest", "use": "@vercel/static", "config": { "headers": { "Content-Type": "application/manifest+json" } } },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}