{
  "name": "semacheck-backend",
  "version": "2.0.0",
  "description": "SemaCheck — Kenyan scam/fraud verification platform API",
  "main": "server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "start:cluster": "node --dns-result-order=ipv4first cluster.js",
    "dev": "nodemon --dns-result-order=ipv4first server.js",
    "migrate": "node db/migrate.js",
    "migrate:fix": "node db/add-reminder-columns.js",
    "seed": "node db/seed.js",
    "build": "npm run migrate && npm run migrate:fix || true",
    "reminders": "node jobs/subscriptionMaintenance.js",
    "refresh-kenya-registry": "node jobs/refreshKenyaRegistries.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "npm run build || true"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.5",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.14",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oketchloyd67-del/semacheck-backend.git"
  },
  "keywords": [
    "scam",
    "fraud",
    "verification",
    "kenya",
    "mpesa",
    "paybill",
    "semacheck"
  ],
  "author": "SemaCheck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oketchloyd67-del/semacheck-backend/issues"
  },
  "homepage": "https://semacheck.vercel.app"
}
