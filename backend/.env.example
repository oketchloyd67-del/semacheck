# ============================================================
# SemaCheck — Server environment (copy to .env for local dev)
# Copy this file to .env before running. Values below are
# placeholder/safe defaults; fill real secrets on deployment.
# ============================================================

# --- Server ---
PORT=4800
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me
SESSION_DAYS=7
ALLOWED_ORIGIN=https://semacheck.vercel.app

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/semacheck
PG_POOL_MAX=30

# --- Scaling (optional but recommended above ~1 instance) ---
REDIS_URL=redis://localhost:6379/0
CLUSTER_WORKERS=max

# --- Subscription maintenance scheduler ---
DISABLE_IN_PROCESS_SCHEDULER=false

# ============================================================
# Trust API — keyed-hash API keys & rate limiting
# ============================================================
# Secret used to HMAC-hash raw API keys before storing in DB.
# Every key is verified as: HMAC-SHA256(API_KEY_HASH_SECRET, raw_key)
API_KEY_HASH_SECRET=change-me
# Per-key, per-minute rate limit (requests). Applied by apiRateLimit
# middleware and enforced at plan level via rate_limit_per_min.
RATE_LIMIT_PER_MIN=60
# Security salt for subject-value hashing (scam reports / watch lists).
REPORT_HASH_SALT=semacheck-default-hash-salt

# ============================================================
# Trust API — signed webhook payloads
# ============================================================
# Pre-shared key used to sign webhook payloads (HMAC-SHA256).
# The same secret must be configured in the consuming webhook
# endpoint to verify signatures. Webhook deliveries use
# X-SemaCheck-Signature: t=<epoch>,v1=<hmac-sha256>.
WEBHOOK_SECRET_ENC_KEY=change-me

# ============================================================
# Web Push — VAPID keys (generated via web-push generateVapidKeys)
# ============================================================
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me

# ============================================================
# Tuma payment gateway (api.tuma.co.ke) — handles M-Pesa STK Push
# ============================================================
TUMA_BASE_URL=https://api.tuma.co.ke
TUMA_EMAIL=claimsagency254@gmail.com
TUMA_API_KEY=change-me
TUMA_CALLBACK_URL=https://semacheck.onrender.com

# ============================================================
# Identity verification
# ============================================================
SEARCH_PROVIDER_URL=https://serpapi.com/search
SEARCH_PROVIDER_KEY=change-me
SEARCH_FRESHNESS_DAYS=30

# ============================================================
# CBK licensed digital lenders registry (Kenya-specific database check)
# ============================================================
CBK_DCP_DIRECTORY_URL=https://www.centralbank.go.ke/wp-content/uploads/2026/04/Directory-of-Digital-Credit-Providers-April-2026.pdf

# ============================================================
# Support inbox (contact dialogue box sends here)
# ============================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASS=change-me
BREVO_API_KEY=change-me
MANAGEMENT_EMAIL=claimsagency254@gmail.com

# ============================================================
# WhatsApp (subscription renewal reminders)
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=subscription_reminder
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v23.0
